{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-codeblock.local/schemas/script-interface-doc.v1.json",
  "title": "Flow Script Interface Document v1 - MCP Complete Contract",
  "$comment": "MCP 创建和代码更新使用此完整契约。没有实际参数时可省略 request；有参数或 POST 请求体时按条件填写。",
  "type": "object",
  "required": ["schema_version", "title", "summary", "endpoint", "responses", "logic_description"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "script-interface-doc.v1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "endpoint": {
      "type": "object",
      "required": ["methods", "description"],
      "additionalProperties": false,
      "properties": {
        "methods": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["GET", "POST"]}},
        "path": {"type": "string", "pattern": "^/flow/codeblock/", "description": "Web 页面录入时可省略；MCP 创建时可省略，更新时填写实际脚本路径。最终调用地址为用户提供的域名加 /flow/codeblock/{{脚本ID}}。"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {"$ref": "#/$defs/parameters"},
        "headers": {"$ref": "#/$defs/parameters"},
        "body": {"$ref": "#/$defs/body", "description": "实际需要描述 POST 请求体时填写；没有请求参数时 request 可省略。"}
      }
    },
    "responses": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/response"}},
    "logic_description": {"type": "string", "minLength": 20, "maxLength": 20000},
    "usage_refs": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/usage"}}
  },
  "$defs": {
    "parameters": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "description", "example"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "example": {},
          "default": {},
          "format": {"type": "string", "maxLength": 100},
          "enum_values": {"type": "array", "maxItems": 100}
        }
      }
    },
    "body": {
      "type": "object",
      "required": ["content_type", "schema", "example"],
      "additionalProperties": false,
      "properties": {
        "content_type": {"const": "application/json"},
        "schema": {"$ref": "#/$defs/schema_root"},
        "example": {"description": "必须填写与 schema 一致的调用方请求体值，并覆盖 schema.required 字段；运行时可选字段可以省略。"}
      }
    },
    "response": {
      "type": "object",
      "required": ["status", "description", "content_type", "schema", "example"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "content_type": {"const": "application/json"},
        "schema": {"$ref": "#/$defs/schema_root"},
        "example": {"description": "必须填写与 schema 一致的响应值，并覆盖 schema.required 字段；运行时可选字段可以省略。"}
      }
    },
    "schema_root": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "example": {},
        "properties": {"type": "object", "description": "代码或 example 中键名已知时必须逐项填写，每个值为完整 schema_node。", "additionalProperties": {"$ref": "#/$defs/schema_node"}},
        "items": {"$ref": "#/$defs/schema_node"},
        "additionalProperties": {"description": "仅用于键名运行时才确定且所有值结构相同的动态字典；对象值仍须完整描述其 properties，不得用空 object Schema 兜底任意 JSON 值。", "anyOf": [{"$ref": "#/$defs/schema_node"}, {"type": "boolean"}]},
        "required": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "schema_node": {
      "type": "object",
      "required": ["type", "description", "example"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "example": {},
        "properties": {"type": "object", "description": "代码或 example 中键名已知时必须逐项填写，每个值为完整 schema_node。", "additionalProperties": {"$ref": "#/$defs/schema_node"}},
        "items": {"$ref": "#/$defs/schema_node"},
        "additionalProperties": {"description": "仅用于键名运行时才确定且所有值结构相同的动态字典；对象值仍须完整描述其 properties，不得用空 object Schema 兜底任意 JSON 值。", "anyOf": [{"$ref": "#/$defs/schema_node"}, {"type": "boolean"}]},
        "required": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["app_name"],
      "additionalProperties": false,
      "properties": {
        "app_id": {"type": "string", "maxLength": 200},
        "app_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "location": {"type": "string", "maxLength": 500},
        "note": {"type": "string", "maxLength": 4000}
      }
    }
  }
}
